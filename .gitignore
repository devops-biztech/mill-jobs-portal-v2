# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local sqlite database (contains applicant PII, do not commit)
# The trailing glob is load-bearing: it catches -journal, -wal, and dated
# backup copies like app-db.sqlite3.backup-20260813-103434, which the bare
# `*.sqlite3` pattern does NOT match.
/db/*.sqlite3*

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# generated by `npm run tree -- --preview`
tree-preview.html

# per-machine agent tooling state
.claude/settings.local.json
.claude/scheduled_tasks.lock
.impeccable/config.local.json
.impeccable/hook.cache.json
