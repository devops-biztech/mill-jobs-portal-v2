/// Voluntary EEO survey answers, kept in their own table on purpose.
///
/// This data may not reach anyone making a hiring decision. It exists only
/// for aggregate demographic reporting, which is the sole basis on which it
/// was lawful to ask for it.
///
/// There is deliberately NO Prisma relation to `Application`. A relation
/// would make `include: { demographics: true }` expressible, and sooner or
/// later something would include it — the detail page, an export, the PDF
/// generator. With no relation, reading this requires naming the model
/// explicitly, which is a conscious act that shows up in code review.
///
/// A row is written for every synced application, including ones where the
/// applicant skipped the survey: an empty answer is a real data point (it
/// separates "declined" from "never asked") and response rates matter when
/// interpreting the aggregates.
model ApplicantDemographics {
  applicationId           String  @id
  companyName             String
  /// Copied from the application, so reports can scope by period without
  /// joining back to anything that identifies the applicant.
  date                    String
  /// Comma-joined multi-select, combined race and ethnicity (SPD 15, 2024).
  eeoRacialEthnic         String?
  eeoSex                  String?
  /// Plain-language answer for SLI; the VEVRAA top-level status for TRL.
  eeoVeteran              String?
  /// TRL only. Comma-joined VEVRAA protected-veteran classifications.
  /// Multi-select because a veteran can be both disabled and recently
  /// separated, and the annual VETS-4212 filing counts each category.
  eeoVeteranCategories    String?
  /// TRL only. Set only when "Recently separated veteran" is selected.
  eeoVeteranDischargeDate String?
  /// TRL only. OFCCP Form CC-305 answer.
  eeoDisability           String?
}

//
// The disability and VEVRAA columns are populated by TRL and left null by SLI.
// TRL's own paper application carries Form CC-305 and the VEVRAA
// self-identification form and states its covered federal contractor status
// outright, so TRL asks both questions. SLI's contractor status is
// unconfirmed, so its form asks a plain-language veteran question and nothing
// about disability — see EEO-SURVEY-REVIEW.md in the sli-emp-online repo.
// If SLI's status is ever confirmed, it can start populating these same
// columns without a further migration.

model Storage {
  id                String  @id
  package           String
  companyName       String
  date              String
  receivedByCompany Boolean @default(false)
  dismissApplicant  Boolean @default(false)
}

model User {
  id          String  @id
  fullName    String
  username    String
  password    String
  homeMill    String
  nflAccess   Boolean @default(false)
  trlAccess   Boolean @default(false)
  srmAccess   Boolean @default(false)
  sliAccess   Boolean @default(false)
  stlcAccess  Boolean @default(false)
  glAccess    Boolean @default(false)
  adminAccess Boolean @default(false)
}

